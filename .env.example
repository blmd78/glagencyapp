# ─── Supabase (nouvelles clés sb_publishable_ / sb_secret_) ──
# Web (client + serveur) — clé PUBLISHABLE (sûre côté navigateur, RLS appliquée)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Serveur uniquement (clé SECRET : bypass RLS — ne JAMAIS exposer au navigateur)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Connexion directe Postgres (migrations)
DATABASE_URL=

# ─── MyPuls (ingestion) — SECRETS, jamais en clair dans le code ──
# Depuis ~2026-08-12, /login est protégé par un CAPTCHA Turnstile : le login par
# mot de passe ne marche plus. Coller ici le cookie d'une session ouverte À LA MAIN
# (DevTools → Application → Cookies → mypuls.app), format « PHPSESSID=…; REMEMBERME=… ».
# À renouveler quand il expire (REMEMBERME ≈ 30 j) ; tester avec `pnpm --filter
# @glagency/ingestion check-session`. EMAIL/PASSWORD restent le fallback historique.
MYPULS_SESSION_COOKIE=
MYPULS_EMAIL=
MYPULS_PASSWORD=
MYPULS_API_KEY=

# ─── Good Luck Agency (reprise de l'historique de formation) ──
# Accès Postgres LECTURE SEULE à l'ancienne plateforme (projet Supabase TIERS, encore en prod).
# Rôle dédié `gla_readonly` : aucun droit d'écriture, `select` par colonnes sur `chatters`
# (pw_plain EXCLU) et `select` sur `sessions`. Rôle/mot de passe DISTINCT entre Preview et
# Production — l'URL de Preview atterrit dans le .env de chaque poste de dev.
GLA_DATABASE_URL=
# Optionnelle et NON POSÉE par défaut (D3) : borne le corpus repris à `created_ms <= valeur`.
# À poser le jour où GLA cesse d'être une source vivante (cf. §9.7 de la spec de reprise).
GLA_CUTOFF_MS=

# ─── IA (analyse à la demande) ──────────────────────────────
ANTHROPIC_API_KEY=

# ─── Alertes ingestion (échec du refresh) ───────────────────
TG_BOT_TOKEN=
TG_CHAT_ID=

# Revalidation du cache web après ingestion (secret partagé web ↔ worker)
REVALIDATE_SECRET=
REVALIDATE_URL= # ex. https://<app>.vercel.app/api/revalidate

# ─── Sentry ─────────────────────────────────────────────────
# DSN web (inliné au build Next — pas un secret critique)
NEXT_PUBLIC_SENTRY_DSN=
# Tag d'environnement Sentry ('production' par défaut ; 'preprod' via .env.preprod)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Upload des source maps au build (org/project du dashboard Sentry) — build local only
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
