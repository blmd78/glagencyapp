#!/usr/bin/env bash
#
# pre-push — deux refus. Installation : `git config core.hooksPath scripts/hooks`
# (fait par le script `prepare` au `pnpm install`). Tests : scripts/pre-push.test.mjs.
#
# 1. `main` : push direct ET suppression refusés. `main` ne reçoit que des PR.
#
# 2. Code non relu : refusé. Chaque commit NOUVEAU pour le distant doit être couvert
#    par le tampon que pose le skill `review-feature` quand son verdict est OK
#    (`$(git rev-parse --git-dir)/review-stamp`, propre à chaque worktree), ou ne
#    toucher que de la doc (`*.md` : changelog, carte, PR de doc), ou être un commit
#    de release (`chore(release): …`). Tags et suppressions de branche passent.
#    - Couvert = ancêtre du tampon, ou patch identique à un commit relu (`--cherry-pick` :
#      un rebase propre ou un amend de message ne redemandent pas de revue).
#    - Un merge ne compte que ce qui diffère de TOUS ses parents (`--cc`) : un merge
#      propre passe, une résolution de conflit écrite à la main est du code à relire.
#    - Si l'analyse git échoue, le push est refusé, jamais accepté par défaut.
#
# ⚠️ Ce hook n'est pas une protection : il ne vit que sur la machine, et
# `git push --no-verify` le contourne — échappatoire réservée à l'urgence assumée.

set -o pipefail

remote="$1"
zero=0000000000000000000000000000000000000000
stamp="$(cat "$(git rev-parse --git-dir)/review-stamp" 2>/dev/null)"
# Poussé par URL (pas un distant nommé) : tous les suivis distants comptent comme « déjà poussé ».
if git config --get "remote.$remote.url" >/dev/null 2>&1; then remotes="--remotes=$remote"; else remotes="--remotes"; fi

refuse() {
  printf '\n\033[1;31m⛔ %s\033[0m\n' "$1" >&2
  printf '%b\n' "$2" >&2
  printf 'Urgence assumée : git push --no-verify\n\n' >&2
  exit 1
}
analyse_impossible() {
  refuse "Analyse du push impossible ($1)." "Le hook refuse plutôt que de laisser passer du code non vérifié."
}

while read -r _local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    refuse "Push sur main refusé (suppression comprise)." \
      "main ne reçoit que des PR.\n  git switch -c <branche> && git push -u origin <branche>\n  gh pr create"
  fi
  [ "$local_sha" = "$zero" ] && continue
  case "$remote_ref" in refs/tags/*) continue ;; esac

  # Ce que le distant a déjà : ses suivis locaux, plus le SHA distant fourni par git s'il est connu.
  exclude=""
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then exclude="$remote_sha"; fi

  if [ -n "$stamp" ] && git cat-file -e "$stamp^{commit}" 2>/dev/null; then
    new="$(git rev-list --cherry-pick --right-only "$stamp...$local_sha" --not $remotes $exclude)" || analyse_impossible "rev-list"
  else
    new="$(git rev-list "$local_sha" --not $remotes $exclude)" || analyse_impossible "rev-list"
  fi

  for c in $new; do
    case "$(git log -1 --format=%s "$c")" in "chore(release):"*) continue ;; esac
    files="$(git -c core.quotepath=off diff-tree --root --cc --no-commit-id --name-only -r "$c")" || analyse_impossible "diff-tree $c"
    if ! printf '%s\n' "$files" | grep -v '^$' | grep -qv '\.md$'; then continue; fi
    refuse "Code non relu : $(git log -1 --format='%h %s' "$c")" \
      "Lance le skill review-feature dans ce worktree : son verdict OK pose le tampon\nde revue. Un commit de code ajouté après le tampon impose une nouvelle revue."
  done
done

exit 0
